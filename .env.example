# Configuración de Base de Datos MySQL
MYSQL_ROOT_PASSWORD=cambiar_por_clave_root_robusta
MYSQL_DATABASE=libromundo_db
MYSQL_USER=libromundo_user
MYSQL_PASSWORD=cambiar_por_clave_usuario_robusta

# Configuración de WordPress
WORDPRESS_TABLE_PREFIX=lm_
WORDPRESS_DEBUG=0

# Puertos en Host
WORDPRESS_PORT=8080
PMA_PORT=8081
